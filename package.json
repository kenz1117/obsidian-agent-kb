{
  "name": "obsidian-agent-kb",
  "version": "0.6.0",
  "private": true,
  "description": "An all-in-one Obsidian plugin that gives AI agents a governed local knowledge base.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "lint": "pnpm typecheck",
    "dev:cli": "pnpm --filter @oakb/cli dev",
    "dev:mcp": "pnpm --filter @oakb/mcp dev",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
