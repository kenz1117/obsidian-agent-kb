{
  "name": "obsidian-agent-kb",
  "version": "0.3.1",
  "private": true,
  "description": "A local-first, Obsidian-compatible knowledge operating system for AI agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:cli": "pnpm --filter @oakb/cli dev",
    "dev:mcp": "pnpm --filter @oakb/mcp dev",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
