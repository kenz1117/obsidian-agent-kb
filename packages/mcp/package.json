{
  "name": "@oakb/mcp",
  "version": "0.2.0",
  "description": "SDK-based MCP server backed by the governed Obsidian Agent KB gateway.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "oakb-mcp": "dist/server.js"
  },
  "files": [
    "dist"
