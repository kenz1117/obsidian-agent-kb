# Vault location. Never commit real secrets.
KB_VAULT_ROOT=/absolute/path/to/vault

# Agent identity used by MCP. The identity must also be registered.
KB_AGENT_ID=generic-agent
KB_AGENT_IDS=generic-agent

# Local audit and runtime output; never commit real logs or notes.
KB_RUNTIME_DIR=/absolute/path/to/runtime

# Optional TypeScript adapter timeout in milliseconds (1000-120000).
OAKB_GATEWAY_TIMEOUT_MS=15000
