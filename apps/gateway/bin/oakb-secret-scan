#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, re, subprocess, sys
patterns=[
 r"-----BEGIN (?:RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY-----",
 r"(?i)\b(?:api[_-]?key|secret|token|password|passwd|pwd)\b\s*[:=]\s*['\"]?[A-Za-z0-9_\-]{16,}",
 r"(?i)\b(?:mysql|postgres|postgresql|mongodb(?:\+srv)?|redis)://[^\s/:]+:[^\s@]+@",
 r"\bAKIA[0-9A-Z]{16}\b",
 r"\bsk-[A-Za-z0-9]{20,}\b",
]
compiled=[re.compile(x) for x in patterns]
parser=argparse.ArgumentParser()
parser.add_argument("--staged",action="store_true")
parser.add_argument("repo")
a=parser.parse_args()
text=subprocess.check_output(["git","-C",a.repo]+(["diff","--cached","--unified=0"] if a.staged else ["diff","--unified=0"]),text=True,errors="ignore")
hits=[]
for n,line in enumerate(text.splitlines(),1):
    for p in compiled:
        if p.search(line):
            hits.append({"line":n,"pattern":p.pattern,"sample":line[:180]})
            break
if hits:
    print(json.dumps({"status":"rejected","hits":hits},ensure_ascii=False,indent=2),file=sys.stderr)
    raise SystemExit(2)
print('{"status":"clean"}')
